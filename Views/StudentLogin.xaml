<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentInformationSystemMobile.Views.StudentLogin"
    Title="CS Student Management System">

    <Grid BackgroundColor="White">

        <Image
            Aspect="AspectFit"
            Source="studentlogin.png" />

        <Entry
            x:Name="UsernameEntry"
            FontSize="14"
            HeightRequest="45"
            HorizontalOptions="Start"
            Margin="90,300,0,0"
            Placeholder="Email or Username..."
            TextColor="White"
            VerticalOptions="Start"
            WidthRequest="200"
            />

        <Entry
            x:Name="PasswordEntry"
            FontSize="14"
            HeightRequest="45"
            HorizontalOptions="Start"
            Margin="90,400,0,0"
            Placeholder="Enter Password"
            IsPassword="True"
            TextColor="White"
            VerticalOptions="Start"
            WidthRequest="200"
            />

        <Button
            x:Name="LoginButton"
            BackgroundColor="#FFD042"
            CornerRadius="10"
            FontAttributes="Bold"
            FontSize="16"
            HeightRequest="45"
            HorizontalOptions="Start"
            Margin="90,470,0,0"
            Text="Log In"
            TextColor="#1A237E"
            VerticalOptions="Start"
            WidthRequest="200"
            Clicked="OnLoginClicked" />

        <Label
            FontSize="14"
            HorizontalOptions="Center"
            Margin="0,0,0,60"
            Text="Ask for Support"
            TextColor="White"
            TextDecorations="Underline"
            VerticalOptions="End">

            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSupportTapped" />
            </Label.GestureRecognizers>

        </Label>

    </Grid>
</ContentPage>
